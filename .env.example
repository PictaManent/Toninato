WP_PORT=8080
PMA_PORT=8081

DB_NAME=toninato
DB_USER=toninato
DB_PASSWORD=toninato
DB_ROOT_PASSWORD=root

# Deploy sullo stage (python deploy.py)
# Di default le credenziali FTP si leggono dal sito di FileZilla indicato qui.
DEPLOY_STAGE_FTP_SITE=Demosocialone.it
# In alternativa (es. su un PC senza FileZilla) scommentare e compilare:
# DEPLOY_STAGE_FTP_HOST=ftp.demosocialone.it
# DEPLOY_STAGE_FTP_USER=
# DEPLOY_STAGE_FTP_PASS=
